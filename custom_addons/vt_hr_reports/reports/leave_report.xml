
<odoo>

    <template id="report_leave_summary">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <t t-call="web.external_layout">

                    <div class="page vt-hr-report">

                    <t t-call="vt_hr_reports.hr_report_styles"/>

                        <h2>Leave Request Summary</h2>

                        <p>
                            <strong>Request:</strong>
                            <span t-field="o.name"/>
                        </p>

                        <p>
                            <strong>Status:</strong>

                            <span t-if="o.state == 'approved'"
                                  style="color: #198754;">
                                Approved
                            </span>

                            <span t-elif="o.state == 'rejected'"
                                  style="color: #dc3545;">
                                Rejected
                            </span>

                            <span t-elif="o.state == 'submitted'"
                                  style="color: #9a6700;">
                                Pending Approval
                            </span>

                            <span t-else="">
                                Draft
                            </span>

                        </p>

                        <h4>Request Information</h4>

                        <table class="table table-bordered">

                            <tbody>

                                <tr>
                                    <th style="width: 35%;">
                                        Employee
                                    </th>
                                    <td>
                                        <span t-field="o.employee_id.name"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Leave Type</th>
                                    <td>
                                        <span t-field="o.leave_type"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Start Date</th>
                                    <td>
                                        <span t-field="o.start_date"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>End Date</th>
                                    <td>
                                        <span t-field="o.end_date"/>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Duration</th>
                                    <td>
                                        <span t-field="o.duration"/>
                                        calendar day(s)
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                        <h4 class="mt-4">
                            Approval History
                        </h4>

                        <table class="table table-bordered">

                            <tbody>

                                <tr>
                                    <th style="width: 35%;">
                                        Submitted By
                                    </th>
                                    <td>
                                        <span t-if="o.submitted_by"
                                              t-field="o.submitted_by.name"/>
                                        <span t-else="">
                                            Not recorded
                                        </span>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Submitted At</th>
                                    <td>
                                        <span t-if="o.submitted_at"
                                              t-field="o.submitted_at"/>
                                        <span t-else="">
                                            Not recorded
                                        </span>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Decision By</th>
                                    <td>
                                        <span t-if="o.decision_by"
                                              t-field="o.decision_by.name"/>
                                        <span t-else="">
                                            Not recorded
                                        </span>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Decision At</th>
                                    <td>
                                        <span t-if="o.decision_at"
                                              t-field="o.decision_at"/>
                                        <span t-else="">
                                            Not recorded
                                        </span>
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                        <p t-if="o.state == 'submitted'">
                            This request is awaiting an
                            authorized HR decision.
                        </p>

                        <p t-if="o.state == 'draft'">
                            This document does not represent
                            an approved leave request.
                        </p>

                        <p class="text-muted mt-3">
                            Confidential - Internal HR Use
                        </p>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>
