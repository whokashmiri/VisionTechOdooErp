<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        NOTE: char fields such as report_name / report_file / print_report_name
        must be on a single line. Odoo does not strip whitespace from XML text,
        so a value split across lines is stored with newlines and the QWeb
        template lookup fails ("External ID not found").
    -->

    <record id="action_report_employee_profile" model="ir.actions.report">
        <field name="name">Employee Profile</field>
        <field name="model">vt.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vt_hr_reports.report_employee_profile</field>
        <field name="report_file">vt_hr_reports.report_employee_profile</field>
        <field name="paperformat_id" ref="vt_hr_reports.paperformat_hr_a4"/>
        <field name="binding_model_id" ref="vt_employee.model_vt_employee"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Employee Profile - %s' % object.employee_code</field>
        <field name="group_ids" eval="[(6, 0, [ref('vt_employee.group_vt_employee'), ref('base.group_system')])]"/>
        <field name="attachment_use" eval="False"/>
    </record>

    <record id="action_report_department_employees" model="ir.actions.report">
        <field name="name">Department Employee Listing</field>
        <field name="model">vt.department</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vt_hr_reports.report_department_employees</field>
        <field name="report_file">vt_hr_reports.report_department_employees</field>
        <field name="paperformat_id" ref="vt_hr_reports.paperformat_hr_a4"/>
        <field name="binding_model_id" ref="vt_employee.model_vt_department"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Department Employees - %s' % object.code</field>
        <field name="group_ids" eval="[(6, 0, [ref('vt_employee.group_vt_hr_user'), ref('base.group_system')])]"/>
        <field name="attachment_use" eval="False"/>
    </record>

</odoo>
