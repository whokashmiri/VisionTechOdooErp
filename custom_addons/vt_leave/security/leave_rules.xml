<odoo>

    <record id="rule_leave_own" model="ir.rule">
        <field name="name">Leave: Own Requests</field>
        <field name="model_id" ref="model_vt_leave_request"/>
        <field name="groups"
               eval="[(4, ref('vt_employee.group_vt_employee'))]"/>
        <field name="domain_force">
            [('requester_id', '=', user.id)]
        </field>
    </record>

    <record id="rule_leave_hr_read" model="ir.rule">
        <field name="name">Leave: HR Read All</field>
        <field name="model_id" ref="model_vt_leave_request"/>
        <field name="groups"
               eval="[(4, ref('vt_employee.group_vt_hr_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>

        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_leave_manager" model="ir.rule">
        <field name="name">Leave: HR Manager and Administrator</field>
        <field name="model_id" ref="model_vt_leave_request"/>
        <field name="groups"
               eval="[(4, ref('vt_employee.group_vt_hr_manager')),
                      (4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>