
<odoo>

    <record id="view_orderpoint_list_vt_extension"
            model="ir.ui.view">

        <field name="name">
            stock.warehouse.orderpoint.list.vt.extension
        </field>

        <field name="model">
            stock.warehouse.orderpoint
        </field>

        <field name="inherit_id"
               ref="stock.view_warehouse_orderpoint_tree_editable"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='product_min_qty']"
                   position="after">

                <field name="vt_stock_status"
                       widget="badge"
                       readonly="True"
                       optional="show"
                       decoration-success="vt_stock_status == 'normal'"
                       decoration-warning="vt_stock_status == 'low'"
                       decoration-danger="vt_stock_status == 'negative'"/>

                <field name="vt_shortage_qty"
                       readonly="True"
                       optional="show"/>

            </xpath>

        </field>

    </record>

</odoo>
