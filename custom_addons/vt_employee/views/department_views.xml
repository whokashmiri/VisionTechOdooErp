
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Department List View -->
    <record id="view_vt_department_list" model="ir.ui.view">
        <field name="name">vt.department.list</field>
        <field name="model">vt.department</field>
        <field name="arch" type="xml">

            <list string="Departments"
                  default_order="name asc">

                <field name="code"/>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="employee_count"/>

            </list>

        </field>
    </record>

    <!-- Department Form View -->
    <record id="view_vt_department_form" model="ir.ui.view">
        <field name="name">vt.department.form</field>
        <field name="model">vt.department</field>
        <field name="arch" type="xml">

            <form string="Department">

                <sheet>

                    <div class="oe_button_box"
                         name="button_box">

                        <button name="action_view_employees"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">

                            <field name="employee_count"
                                   widget="statinfo"
                                   string="Employees"/>

                        </button>

                    </div>

                    <field name="active" invisible="True"/>

                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Department Name"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Department Information">

                            <field name="code"/>

                            <field name="manager_id"
                                   options="{'no_create': True}"/>

                        </group>

                        <group string="Statistics">

                            <field name="employee_count"
                                   readonly="True"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Employees"
                              name="employees">

                            <field name="employee_ids"
                                   readonly="True">

                                <list>
                                    <field name="employee_code"/>
                                    <field name="name"/>
                                    <field name="manager_id"/>

                                    <field name="status"
                                           widget="badge"
                                           decoration-success="status == 'active'"
                                           decoration-warning="status == 'inactive'"
                                           decoration-danger="status == 'resigned'"/>
                                </list>

                            </field>

                        </page>

                        <page string="Description"
                              name="description">

                            <field name="description"
                                   placeholder="Describe the responsibilities of this department..."/>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>

    <!-- Department Search View -->
    <record id="view_vt_department_search" model="ir.ui.view">
        <field name="name">vt.department.search</field>
        <field name="model">vt.department</field>
        <field name="arch" type="xml">

            <search string="Search Departments">

                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>

                <separator/>

                <filter name="without_manager"
                        string="Without Manager"
                        domain="[('manager_id', '=', False)]"/>

                <separator/>

                <filter name="archived_departments"
                        string="Archived"
                        domain="[('active', '=', False)]"
                        context="{'active_test': False}"/>

                <separator/>

                <filter name="group_by_manager"
                        string="Manager"
                        context="{'group_by': 'manager_id'}"/>

            </search>

        </field>
    </record>

    <!-- Department Window Action -->
    <record id="action_vt_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">vt.department</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_vt_department_search"/>
    </record>

</odoo>
