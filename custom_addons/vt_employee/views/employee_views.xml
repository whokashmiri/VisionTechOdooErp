

<odoo>

    <!-- Employee List View -->
    <record id="view_vt_employee_list" model="ir.ui.view">
        <field name="name">vt.employee.list</field>
        <field name="model">vt.employee</field>
        <field name="arch" type="xml">
            <list string="Employees"
                  default_order="employee_code asc">

                <field name="employee_code"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="manager_id" optional="show"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="joining_date" optional="show"/>

                <field name="status"
                       widget="badge"
                       decoration-success="status == 'active'"
                       decoration-warning="status == 'inactive'"
                       decoration-danger="status == 'resigned'"/>

            </list>
        </field>
    </record>

    <!-- Employee Form View -->
    <record id="view_vt_employee_form" model="ir.ui.view">
        <field name="name">vt.employee.form</field>
        <field name="model">vt.employee</field>
        <field name="arch" type="xml">
            <form string="Employee">

                <header>
                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="active,inactive,resigned"
                           options="{'clickable': True}"/>
                </header>

                <sheet>

                    <field name="active" invisible="True"/>

                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Employee Name"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Personal Information"
                               name="personal_information">

                            <field name="employee_code"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>

                        </group>

                        <group string="Employment Information"
                               name="employment_information">

                            <field name="department_id"
                                   options="{'no_create': True}"/>

                            <field name="manager_id"
                                   domain="[('id', '!=', id)]"
                                   options="{'no_create': True}"/>

                            <field name="joining_date"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Subordinates"
                              name="subordinates">

                            <field name="subordinate_ids"
                                   readonly="True">
                                <list>
                                    <field name="employee_code"/>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="status"/>
                                </list>
                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <!-- Employee Search View -->
    <record id="view_vt_employee_search" model="ir.ui.view">
        <field name="name">vt.employee.search</field>
        <field name="model">vt.employee</field>
        <field name="arch" type="xml">
            <search string="Search Employees">

                <field name="name"/>
                <field name="employee_code"/>
                <field name="email"/>
                <field name="department_id"/>
                <field name="manager_id"/>

                <separator/>

                <filter name="active_employees"
                        string="Active Employees"
                        domain="[('status', '=', 'active')]"/>

                <filter name="inactive_employees"
                        string="Inactive Employees"
                        domain="[('status', '=', 'inactive')]"/>

                <filter name="resigned_employees"
                        string="Resigned Employees"
                        domain="[('status', '=', 'resigned')]"/>

                <separator/>

                <filter name="archived_employees"
                        string="Archived"
                        domain="[('active', '=', False)]"
                        context="{'active_test': False}"/>

                <separator/>

                <filter name="no_manager"
                        string="Without Manager"
                        domain="[('manager_id', '=', False)]"/>

                <separator/>

                <filter name="group_by_department"
                        string="Department"
                        context="{'group_by': 'department_id'}"/>

                <filter name="group_by_manager"
                        string="Manager"
                        context="{'group_by': 'manager_id'}"/>

                <filter name="group_by_status"
                        string="Employment Status"
                        context="{'group_by': 'status'}"/>

                <filter name="group_by_joining_date"
                        string="Joining Month"
                        context="{'group_by': 'joining_date:month'}"/>

            </search>
        </field>
    </record>

    <!-- Employee Window Action -->
    <record id="action_vt_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">vt.employee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_vt_employee_search"/>
    </record>

</odoo>
