
<odoo>

    <!-- Employee: Read Own Record -->
    <record id="rule_vt_employee_own" model="ir.rule">
        <field name="name">Employee: Own Record</field>

        <field name="model_id" ref="model_vt_employee"/>
        <field name="groups" eval="[(4, ref('group_vt_employee'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>

    </record>

    <!-- HR User: Read All Employee Records -->
    <record id="rule_vt_hr_user_all" model="ir.rule">
        <field name="name">HR User: All Employees</field>

        <field name="model_id" ref="model_vt_employee"/>
        <field name="groups" eval="[(4, ref('group_vt_hr_user'))]"/>
        <field name="domain_force">[(1, '=', 1)] </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>

    </record>

    <!-- HR Manager: Full Employee Access -->
    <record id="rule_vt_hr_manager_all" model="ir.rule">
        <field name="name">HR Manager: All Employees</field>

        <field name="model_id" ref="model_vt_employee"/>
        <field name="groups" eval="[(4, ref('group_vt_hr_manager'))]"/>
        <field name="domain_force"> [(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- System Administrator: Full Employee Access -->
    <record id="rule_vt_admin_all" model="ir.rule">
        <field name="name">Administrator: All Employees</field>
    
        <field name="model_id" ref="model_vt_employee"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
