
<odoo>

    <record id="rule_attendance_own" model="ir.rule">
        <field name="name">Attendance: Own Records</field>
        <field name="model_id" ref="model_vt_attendance"/>
        <field name="groups"
               eval="[(4, ref('vt_employee.group_vt_employee'))]"/>
        <field name="domain_force">
            [('owner_id', '=', user.id)]
        </field>
    </record>

    <record id="rule_attendance_hr" model="ir.rule">
        <field name="name">Attendance: HR Read All</field>
        <field name="model_id" ref="model_vt_attendance"/>
        <field name="groups"
               eval="[(4, ref('vt_employee.group_vt_hr_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_attendance_manager" model="ir.rule">
        <field name="name">Attendance: Manager Access</field>
        <field name="model_id" ref="model_vt_attendance"/>
        <field name="groups"
               eval="[(4, ref('vt_employee.group_vt_hr_manager')),
                      (4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>